{
  "name": "FeedTheVoidPhase15PlayableLoop",
  "description": "Phase 1.5 playable-loop stabilization for FEED THE VOID. Updates existing server/client scripts and shared configs without deleting user content.",
  "steps": [
    { "type": "ensureFolder", "path": "ReplicatedStorage.Shared" },
    { "type": "ensureFolder", "path": "ReplicatedStorage.Remotes" },
    { "type": "ensureFolder", "path": "ServerScriptService.Server" },
    { "type": "ensureFolder", "path": "ServerScriptService.Server.Services" },
    { "type": "ensureFolder", "path": "StarterPlayer.StarterPlayerScripts.Controllers" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestPlantSnack" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestHarvestSnack" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestSellSnack" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestFeedVoid" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestDisplaySnack" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestClearVoidmite" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestBuySeed" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.RequestRebirth" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.NotifyClient" },
    { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.SyncPlayerData" },
    { "type": "writeScript", "path": "ReplicatedStorage.Shared.GameConfig", "className": "ModuleScript", "sourceFile": "src/Shared/GameConfig.lua", "overwrite": true },
    { "type": "writeScript", "path": "ReplicatedStorage.Shared.SnackConfig", "className": "ModuleScript", "sourceFile": "src/Shared/SnackConfig.lua", "overwrite": true },
    { "type": "writeScript", "path": "ReplicatedStorage.Shared.MutationConfig", "className": "ModuleScript", "sourceFile": "src/Shared/MutationConfig.lua", "overwrite": true },
    { "type": "writeScript", "path": "ReplicatedStorage.Shared.EventConfig", "className": "ModuleScript", "sourceFile": "src/Shared/EventConfig.lua", "overwrite": true },
    { "type": "writeScript", "path": "ReplicatedStorage.Shared.FormatNumbers", "className": "ModuleScript", "sourceFile": "src/Shared/FormatNumbers.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Main", "className": "Script", "sourceFile": "src/Server/Main.server.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.ProfileServiceWrapper", "className": "ModuleScript", "sourceFile": "src/Server/Services/ProfileServiceWrapper.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.AnalyticsService", "className": "ModuleScript", "sourceFile": "src/Server/Services/AnalyticsService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.InventoryService", "className": "ModuleScript", "sourceFile": "src/Server/Services/InventoryService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.EconomyService", "className": "ModuleScript", "sourceFile": "src/Server/Services/EconomyService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.PlotService", "className": "ModuleScript", "sourceFile": "src/Server/Services/PlotService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.ShopService", "className": "ModuleScript", "sourceFile": "src/Server/Services/ShopService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.EventService", "className": "ModuleScript", "sourceFile": "src/Server/Services/EventService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.VoidService", "className": "ModuleScript", "sourceFile": "src/Server/Services/VoidService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.SnackService", "className": "ModuleScript", "sourceFile": "src/Server/Services/SnackService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.VoidmiteService", "className": "ModuleScript", "sourceFile": "src/Server/Services/VoidmiteService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.RebirthService", "className": "ModuleScript", "sourceFile": "src/Server/Services/RebirthService.lua", "overwrite": true },
    { "type": "writeScript", "path": "ServerScriptService.Server.Services.VisitRewardService", "className": "ModuleScript", "sourceFile": "src/Server/Services/VisitRewardService.lua", "overwrite": true },
    { "type": "writeScript", "path": "StarterPlayer.StarterPlayerScripts.ClientMain", "className": "LocalScript", "sourceFile": "src/Client/ClientMain.client.lua", "overwrite": true },
    { "type": "writeScript", "path": "StarterPlayer.StarterPlayerScripts.Controllers.NotificationController", "className": "ModuleScript", "sourceFile": "src/Client/Controllers/NotificationController.lua", "overwrite": true },
    { "type": "writeScript", "path": "StarterPlayer.StarterPlayerScripts.Controllers.PromptController", "className": "ModuleScript", "sourceFile": "src/Client/Controllers/PromptController.lua", "overwrite": true },
    { "type": "writeScript", "path": "StarterPlayer.StarterPlayerScripts.Controllers.UIController", "className": "ModuleScript", "sourceFile": "src/Client/Controllers/UIController.lua", "overwrite": true }
  ]
}
