      { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.EnemyWaveState" },
      { "type": "ensureRemoteEvent", "path": "ReplicatedStorage.Remotes.EnemyWaveAction" },
      {
        "type": "writeScript",
        "className": "ModuleScript",
        "path": "ReplicatedStorage.CodexSystems.EnemyWave.Contract",
        "source": "local Contract = {}\n\nContract.id = \"enemy-wave\"\nContract.remotes = { \"EnemyWaveState\", \"EnemyWaveAction\" }\nContract.generatedBy = \"Codex Studio Bridge V15\"\n\nreturn Contract\n"
      }
