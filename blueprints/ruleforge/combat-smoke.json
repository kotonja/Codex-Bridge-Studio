{
  "name": "Ruleforge V6 Combat Smoke",
  "mode": "supervised",
  "description": "Safe combat smoke scenario markers, remotes, and inert diagnostics.",
  "steps": [
    {
      "type": "ensureFolder",
      "path": "Workspace.RuleforgeV6Scenarios"
    },
    {
      "type": "ensureFolder",
      "path": "Workspace.RuleforgeV6Scenarios.CombatSmoke"
    },
    {
      "type": "ensureRemoteEvent",
      "path": "ReplicatedStorage.Remotes.CombatRequest"
    },
    {
      "type": "ensureRemoteEvent",
      "path": "ReplicatedStorage.Remotes.CombatFX"
    },
    {
      "type": "ensureRemoteEvent",
      "path": "ReplicatedStorage.Remotes.AbilityCooldown"
    },
    {
      "type": "createPart",
      "path": "Workspace.RuleforgeV6Scenarios.CombatSmoke.Marker",
      "properties": {
        "Anchored": true,
        "CanCollide": false,
        "Size": { "__type": "Vector3", "x": 6, "y": 0.5, "z": 6 },
        "Position": { "__type": "Vector3", "x": 0, "y": 4, "z": 0 }
      }
    },
    {
      "type": "ensureFolder",
      "path": "ReplicatedStorage.CodexDiagnostics"
    },
    {
      "type": "writeScript",
      "path": "ReplicatedStorage.CodexDiagnostics.CombatSmokeNotes",
      "className": "ModuleScript",
      "source": "return {\n\tname = \"CombatSmoke\",\n\tpurpose = \"Inspect CombatRequest, CombatFX, and AbilityCooldown during a supervised playtest.\",\n\tcreatedBy = \"Codex Studio Bridge V7\"\n}\n"
    }
  ]
}
