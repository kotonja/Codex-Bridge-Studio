{
  "name": "Ruleforge V6 Enemy Wave Smoke",
  "mode": "supervised",
  "description": "Safe enemy wave smoke scenario marker and inert diagnostics.",
  "steps": [
    {
      "type": "ensureFolder",
      "path": "Workspace.RuleforgeV6Scenarios"
    },
    {
      "type": "ensureFolder",
      "path": "Workspace.RuleforgeV6Scenarios.EnemyWaveSmoke"
    },
    {
      "type": "ensureFolder",
      "path": "Workspace.LiveEnemies"
    },
    {
      "type": "ensureFolder",
      "path": "Workspace.EnemySpawns"
    },
    {
      "type": "createPart",
      "path": "Workspace.RuleforgeV6Scenarios.EnemyWaveSmoke.Marker",
      "properties": {
        "Anchored": true,
        "CanCollide": false,
        "Size": { "__type": "Vector3", "x": 7, "y": 0.5, "z": 7 },
        "Position": { "__type": "Vector3", "x": 0, "y": 4, "z": 18 }
      }
    },
    {
      "type": "ensureFolder",
      "path": "ReplicatedStorage.CodexDiagnostics"
    },
    {
      "type": "writeScript",
      "path": "ReplicatedStorage.CodexDiagnostics.EnemyWaveSmokeNotes",
      "className": "ModuleScript",
      "source": "return {\n\tname = \"EnemyWaveSmoke\",\n\tpurpose = \"Inspect LiveEnemies, EnemySpawns, and wave attributes during a supervised playtest.\",\n\tcreatedBy = \"Codex Studio Bridge V7\"\n}\n"
    }
  ]
}
